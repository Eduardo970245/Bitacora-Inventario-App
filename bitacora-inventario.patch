+      : programAddressInput.address;
+
+  // Account meta helper.
+  const getAccountMeta = getAccountMetaFactory(programAddress, "programId");
+
+  // Original accounts.
+  const originalAccounts = {
+    owner: { value: input.owner ?? null, isSigner: true, isWritable: true },
+    almacen: {
+      value: input.almacen ?? null,
+      isSigner: false,
+      isWritable: false,
+    },
+    articulo: {
+      value: input.articulo ?? null,
+      isSigner: false,
+      isWritable: true,
+    },
+    movimiento: {
+      value: input.movimiento ?? null,
+      isSigner: false,
+      isWritable: true,
+    },
+  };
+  const accounts = originalAccounts as Record<
+    keyof typeof originalAccounts,
+    ResolvedInstructionAccount
+  >;
+
+  // Original args.
+  const args = { ...input };
+
+  return Object.freeze({
+    accounts: [
+      getAccountMeta("owner", accounts.owner),
+      getAccountMeta("almacen", accounts.almacen),
+      getAccountMeta("articulo", accounts.articulo),
+      getAccountMeta("movimiento", accounts.movimiento),
+    ],
+    data: getAnularMovimientoInstructionDataEncoder().encode(
+      args as AnularMovimientoInstructionDataArgs,
+    ),
+    programAddress,
+  } as AnularMovimientoInstruction<
+    TProgramAddress,
+    ResolvedInstructionAccountMeta<
+      TAccountOwner,
+      InstructionAccountInputAddress<TAccountOwner>
+    >,
+    ResolvedInstructionAccountMeta<
+      TAccountAlmacen,
+      InstructionAccountInputAddress<TAccountAlmacen>
+    >,
+    ResolvedInstructionAccountMeta<
